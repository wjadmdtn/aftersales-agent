# All handoff rules are configurable; nothing here is hard-coded in the code.
# Lists are JSON arrays of strings.

# --- (2) risk trigger ---
HANDOFF_RISK_AMOUNT_THRESHOLD=500
HANDOFF_RISK_KEYWORDS=["投诉","消协","12315","曝光","举报","起诉","差评","骗子","欺诈"]
HANDOFF_ANGRY_KEYWORDS=["垃圾","什么破","太差","恶心","滚","废物","投诉你们"]

# --- (3) user explicitly asks for a human ---
HANDOFF_USER_REQUEST_KEYWORDS=["转人工","人工客服","人工","找真人","真人","找客服","客服电话"]

# --- (4) human unavailable -> decline ---
HANDOFF_HUMAN_DECLINE_KEYWORDS=["不归我管","非工作","已下班","转错","不受理"]

# --- (1) system error thresholds ---
HANDOFF_TOOL_FAILURE_THRESHOLD=3
HANDOFF_SCHEMA_RETRY_LIMIT=2
HANDOFF_LLM_TIMEOUT_THRESHOLD=2

# --- capability boundary ---
HANDOFF_RAG_SIMILARITY_THRESHOLD=0.6

# --- queue ---
HANDOFF_EXPECTED_WAIT_SECONDS=120
HANDOFF_QUEUE_TIMEOUT_MULTIPLIER=2.0

# --- infra ---
APP_REDIS_URL=redis://localhost:6379/0
