# 业务数据
MOCK_SEED_PATH=seed/orders.json

# 故障注入
MOCK_FAULT_ENABLED=true
MOCK_CALLER_TIMEOUT_MS=3000

# 并发
MOCK_REFUND_LOCK_SHARDS=16

# 可观测
MOCK_CALL_RECORD_CAPACITY=10000
MOCK_DEBUG_ENDPOINTS_ENABLED=true
MOCK_LOG_LEVEL=INFO

# --- Agent (feature 002) ---
MOCK_LLM_TIMEOUT_MS=120000
MOCK_REDIS_URL=
MOCK_SESSION_TTL_SECONDS=86400
MOCK_CONFIRM_TTL_SECONDS=300
# LLM 配置：DashScope 兼容 OpenAI 接口
# MOCK_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MOCK_LLM_API_KEY=<从环境变量注入，切勿写入本文件>
# MOCK_LLM_MODEL=qwen-plus
MOCK_LLM_BASE_URL=
MOCK_LLM_API_KEY=
MOCK_LLM_MODEL=
MOCK_MOCK_SERVICE_BASE_URL=http://localhost:8000

# --- Policy RAG (feature 005) ---
MOCK_POLICY_ENABLED=true
MOCK_POLICY_SEED_PATH=seed/policies/policies.json
# 留空则使用内存条款存储（CI / 本地无 PG）；配置后走 pgvector
MOCK_PG_DSN=
# MOCK_PG_DSN=postgresql://postgres:postgres@localhost:5433/aftersales
MOCK_RAG_EMBEDDER=stub
MOCK_RAG_EMBEDDING_DIM=1024
MOCK_RAG_RECALL_TOP_K=5
MOCK_RAG_RERANK_TOP_N=2
# 阈值必须用真实 embedding + 正负样本标定，0.6 只是占位值
MOCK_RAG_SIMILARITY_THRESHOLD=0.6
MOCK_RAG_AMBIGUITY_MARGIN=0.05
MOCK_RAG_TIMEOUT_MS=800
