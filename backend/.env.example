# 业务数据
MOCK_SEED_PATH=seed/orders.json

# 故障注入
MOCK_FAULT_ENABLED=true
MOCK_CALLER_TIMEOUT_MS=3000

# 并发
MOCK_REFUND_LOCK_SHARDS=16

# 可观测
MOCK_CALL_RECORD_CAPACITY=10000
MOCK_DEBUG_ENDPOINTS_ENABLED=true
MOCK_LOG_LEVEL=INFO

# --- Agent (feature 002) ---
MOCK_LLM_TIMEOUT_MS=120000
MOCK_REDIS_URL=
MOCK_SESSION_TTL_SECONDS=86400
MOCK_CONFIRM_TTL_SECONDS=300
# LLM 配置：DashScope 兼容 OpenAI 接口
# MOCK_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MOCK_LLM_API_KEY=<从环境变量注入，切勿写入本文件>
# MOCK_LLM_MODEL=qwen-plus
MOCK_LLM_BASE_URL=
MOCK_LLM_API_KEY=
MOCK_LLM_MODEL=
MOCK_MOCK_SERVICE_BASE_URL=http://localhost:8000
