  "components": {
    "schemas": {
      "Address": {
        "properties": {
          "receiver": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Receiver"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\d{6,20}$",
            "title": "Phone"
          },
          "province": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Province"
          },
          "city": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "City"
          },
          "district": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "District"
          },
          "detail": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "receiver",
          "phone",
          "province",
          "city",
          "district",
          "detail"
        ],
        "title": "Address"
      },
      "BizResult": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ResultCode"
          },
          "data": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "meta": {
            "$ref": "#/components/schemas/ResultMeta"
          }
        },
        "type": "object",
        "required": [
          "code",
          "meta"
        ],
        "title": "BizResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RefundRequest": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          }
        },
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "RefundRequest"
      },
      "ResultCode": {
        "type": "integer",
        "enum": [
          1000,
          2001,
          2002,
          2003,
          3001,
          3002,
          3003,
          3004,
          3005,
          3006,
          4001,
          4002,
          4003
        ],
        "title": "ResultCode"
      },
      "ResultMeta": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "trace_id"
        ],
        "title": "ResultMeta"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}